[Unit]
Description=SmartTask AI FastAPI Web Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/smarttask_ai
ExecStart=/opt/smarttask_ai/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
